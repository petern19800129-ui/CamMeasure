<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_progress_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_progress_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GTG · Today"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_progress_sets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="DL 0/0 · RDL 0/0"
            android:textColor="#FFCDD2E3"
            android:textSize="14sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_progress_refresh"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Refresh widget"
        android:gravity="center"
        android:text="↻"
        android:textColor="#FFDDE4FF"
        android:textSize="22sp" />
</LinearLayout>
